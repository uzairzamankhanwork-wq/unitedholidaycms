# Copy this file to .env and fill in your own values before starting the server.
# Never commit your real .env file.

# Port the server runs on
PORT=3000

# Initial admin account (only used the FIRST time the server starts,
# to create the admin user in the database). Change the password
# before deploying, and change it again from the admin panel afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Set to "true" only when deploying behind HTTPS (e.g. on a real domain).
# Keep "false" for local development over plain http://localhost.
COOKIE_SECURE=false
